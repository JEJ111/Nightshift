#include <windows.h>
1 ICON "NightShift.ico"
1 RT_MANIFEST "launcher.manifest"
1 VERSIONINFO
 FILEVERSION 0,5,1,0
 PRODUCTVERSION 0,5,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "NightShift installer"
   VALUE "ProductName", "NightShift"
   VALUE "FileVersion", "0.5.1"
   VALUE "ProductVersion", "0.5.1"
   VALUE "OriginalFilename", "Install NightShift.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
